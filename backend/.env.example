APP_NAME="Product Catalogue API"
APP_ENV=local
# APP_KEY is generated automatically on first Docker start.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Browser origin(s) allowed by CORS, comma-separated.
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# No database is used; keep sessions/cache off the database.
SESSION_DRIVER=array
CACHE_STORE=file

# Product source (see App\Providers\AppServiceProvider).
PRODUCTS_PROVIDER=fake_store
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT=8
CATALOGUE_CACHE_TTL=300
ENQUIRY_RATE_LIMIT=5

# Email: "log" writes messages to storage/logs/laravel.log (no account needed).
# For real delivery set MAIL_MAILER=smtp and the MAIL_* SMTP settings below.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="catalogue@example.test"
MAIL_FROM_NAME="Product Catalogue"
SALES_INBOX=sales@example.test
