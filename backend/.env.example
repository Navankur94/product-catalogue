APP_NAME="Product Catalogue API"
APP_ENV=local
# APP_KEY is generated automatically on first Docker start.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
LOG_LEVEL=debug
PRODUCTS_PROVIDER=fake_store
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT=8
MAIL_MAILER=log
MAIL_FROM_ADDRESS="catalogue@example.test"
MAIL_FROM_NAME="Product Catalogue"
SALES_INBOX=sales@example.test
